{
  "expo": {
    "name": "INFOTESS SDMS",
    "slug": "infotess-sdms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "infotess",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aamusted.infotess",
      "infoPlist": {
        "cameraDescription": "INFOTESS needs camera access to scan QR codes for receipt verification."
      }
    },
    "android": {
      "package": "com.aamusted.infotess",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", {
        "image": "./assets/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#0B0F14"
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://infotess.example.com/api",
      "eas": {
        "projectId": ""
      }
    },
    "owner": "aamusted-infotess"
  }
}
